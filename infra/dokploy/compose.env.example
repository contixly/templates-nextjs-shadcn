# Required build and runtime values
DATABASE_URL=postgresql://replace-with-a-secret@database.invalid:5432/replace-with-database
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-secret
BETTER_AUTH_SECRET=replace-with-a-secret
BETTER_AUTH_URL=https://example.com
NEXT_PUBLIC_APP_BASE_URL=https://example.com
NEXT_PUBLIC_YM_COUNTER_ID=
NEXT_DEPLOYMENT_ID=replace-with-deployment-id

# Optional OAuth providers
GOOGLE_CLIENT_ID=replace-with-client-id
GOOGLE_CLIENT_SECRET=replace-with-a-secret
GITHUB_CLIENT_ID=replace-with-client-id
GITHUB_CLIENT_SECRET=replace-with-a-secret
GITLAB_CLIENT_ID=replace-with-client-id
GITLAB_CLIENT_SECRET=replace-with-a-secret
VK_CLIENT_ID=replace-with-client-id
YANDEX_CLIENT_ID=replace-with-client-id
YANDEX_CLIENT_SECRET=replace-with-a-secret

# Required external Redis-compatible cache for the two web replicas
REDIS_URL=redis://cache.invalid:6379
REDIS_PASSWORD=replace-with-a-secret
REMOTE_CACHING_PREFIX=nextjs-shadcn

# Public content defaults
PUBLIC_DEFAULT_LOCALE=en
